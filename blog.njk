---
layout: base.njk
title: Blog
heading: Blog Posts
---
<section>
    {% for post in collections.posts | reverse %}
    <article>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <p><small>{{ post.date.toDateString() }}</small></p>
        <p>{{ post.templateContent | striptags | truncate(150) }}</p>
    </article>
    <hr>
    {% endfor %}
</section>
